<muxc:Window
    x:Class="SpecCheck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="SpecCheck v0.1.0"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock
                    x:Name="CpuText"
                    Text="CPU: Detecting..."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Margin="0,0,0,6"/>
                <TextBlock
                    x:Name="GpuText"
                    Text="GPU: Detecting..."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Margin="0,0,0,6"/>
                <TextBlock
                    x:Name="RamText"
                    Text="RAM: Detecting..."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Margin="0,0,0,6"/>
                <TextBlock
                    x:Name="OsText"
                    Text="OS: Detecting..."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Margin="0,0,0,6"/>
                <TextBlock
                    x:Name="SourceText"
                    Text="Source: —"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Margin="0,0,0,12"/>

                <Button
                    x:Name="DetectButton"
                    Content="Detect Hardware"
                    Click="OnDetectClick"
                    HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</muxc:Window>
