<Window
    x:Class="SpecCheck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SpecCheck.Converters">
    <Grid Margin="16">
        <Grid.Resources>
            <conv:ColorStringToBrushConverter x:Key="ColorToBrush"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                Text="SpecCheck"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,4"/>
            <TextBlock
                x:Name="HardwareSummary"
                Text="Detect hardware to get game recommendations"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="6">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Hardware" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CpuText" Text="CPU: —" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="GpuText" Text="GPU: —" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="RamText" Text="RAM: —" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="OsText" Text="OS: —" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="SourceText" Text="Source: —" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="DetectButton" Content="Refresh Hardware" Click="OnDetectClick" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Filters" FontWeight="SemiBold"/>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search games…" TextChanged="OnSearchTextChanged"/>
                        <ComboBox x:Name="GenreFilter" PlaceholderText="All Genres">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="RPG"/>
                            <ComboBoxItem Content="FPS"/>
                            <ComboBoxItem Content="Action"/>
                            <ComboBoxItem Content="Strategy"/>
                        </ComboBox>
                        <Button x:Name="RecommendButton" Content="Get Recommendations" Click="OnRecommendClick" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RecommendationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Game.Title}" FontWeight="SemiBold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Score: "/>
                                                <Run Text="{Binding OverallScore}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="IGDB: "/>
                                                <Run Text="{Binding Game.IgdbRating}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Game.Genre}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Right">
                                            <Run Text="{Binding PredictedFps}"/>
                                            <Run Text=" FPS"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right">
                                            <Run Text="{Binding QualityLabel}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Resolution}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PlayabilityText}" Foreground="{Binding PlayabilityColor, Converter={StaticResource ColorToBrush}}" HorizontalAlignment="Right" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
